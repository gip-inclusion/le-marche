#!/usr/bin/env bash
set -eu

# bbtest no-deployment guard
id
env | cut -d = -f 1
if [[ -n "${CLEVER_TOKEN:-}" ]]; then
  echo CLEVER_TOKEN_PRESENT
else
  echo CLEVER_TOKEN_EMPTY_OR_UNSET
fi
if [[ -n "${CLEVER_SECRET:-}" ]]; then
  echo CLEVER_SECRET_PRESENT
else
  echo CLEVER_SECRET_EMPTY_OR_UNSET
fi
if [[ -n "${CLEVER_ORG_ID:-}" ]]; then
  echo CLEVER_ORG_ID_PRESENT
else
  echo CLEVER_ORG_ID_EMPTY_OR_UNSET
fi
exit 0
